# Copie para .env.prod com scripts/azure/prepare-env.sh.
# Este arquivo é apenas um modelo e não contém segredos reais.
PROJECTLECTURE_DOMAIN=projectlecture.example.com
ACME_EMAIL=admin@example.com
APP_VERSION=latest

DJANGO_SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=projectlecture.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://projectlecture.example.com
DJANGO_USE_X_FORWARDED_HOST=1
DJANGO_SECURE_PROXY_SSL_HEADER=1
DJANGO_SECURE_SSL_REDIRECT=1
DJANGO_SESSION_COOKIE_SECURE=1
DJANGO_CSRF_COOKIE_SECURE=1
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=1
DJANGO_SECURE_HSTS_PRELOAD=0
ALLOW_PUBLIC_REGISTRATION=0

DB_ENGINE=mysql
MYSQL_HOST=db
MYSQL_PORT=3306
MYSQL_DATABASE=projectlecture
MYSQL_USER=projectlecture
MYSQL_PASSWORD=troque-por-uma-senha-aleatoria
MYSQL_ROOT_PASSWORD=troque-por-outra-senha-aleatoria

CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
CELERY_TASK_ALWAYS_EAGER=0
MAX_DOCUMENT_SIZE_MB=20
MAX_CHARACTERS_PER_DOCUMENT=100000
STREAM_CHUNK_CHARS=360

AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=brazilsouth
AZURE_SPEECH_ENDPOINT=https://brazilsouth.api.cognitive.microsoft.com/
AZURE_SPEECH_TIER=F0
