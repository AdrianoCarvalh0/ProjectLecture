# Copie este arquivo para .env. Nunca versione o .env real.
# Troque os valores marcados como desenvolvimento antes de publicar.
DJANGO_SECRET_KEY=desenvolvimento-troque-por-uma-chave-longa-e-aleatoria
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000
DJANGO_PORT=8000
ALLOW_PUBLIC_REGISTRATION=1

DB_ENGINE=mysql
MYSQL_HOST=db
MYSQL_PORT=3306
MYSQL_DATABASE=projectlecture
MYSQL_USER=projectlecture
MYSQL_PASSWORD=senha-local-projectlecture
MYSQL_ROOT_PASSWORD=senha-local-root-projectlecture

CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
CELERY_TASK_ALWAYS_EAGER=0
MAX_DOCUMENT_SIZE_MB=20
MAX_CHARACTERS_PER_DOCUMENT=100000
BOOK_PART_MAX_PAGES=10
MAX_DOCUMENTS_PER_USER=10
MAX_DOCUMENTS_PER_USER_PER_DAY=10
MAX_READINGS_PER_USER_MONTH=10

# Login Google e seletor do Drive. O client ID pode ser compartilhado entre os
# dois fluxos; o segredo é usado apenas pelo login no servidor.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Chave de API restrita por origem HTTP às APIs Google Picker e Drive.
GOOGLE_DRIVE_API_KEY=
# Número numérico do projeto Google Cloud (não é o ID textual).
GOOGLE_CLOUD_PROJECT_NUMBER=
# Permite que o popup OAuth devolva o token à janela principal.
DJANGO_SECURE_CROSS_ORIGIN_OPENER_POLICY=same-origin-allow-popups

# Serviço neural local. O primeiro uso baixa o modelo aberto para um volume Docker.
TTS_ENVIRONMENT=development
NEURAL_TTS_URL=http://neural-tts:8100
NEURAL_TTS_PORT=8100
NEURAL_TTS_TIMEOUT_SECONDS=600
KOKORO_MODEL_ID=hexgrad/Kokoro-82M
# Opcional: token somente de leitura para evitar limites anônimos no download.
HF_TOKEN=
TTS_PRELOAD_MODEL=0
TTS_DEVICE=cpu
TORCH_INDEX_URL=https://download.pytorch.org/whl/cpu
TORCH_VERSION=2.13.0
# Para o override GPU, ajuste este índice se sua versão do driver exigir outro CUDA.
TORCH_GPU_INDEX_URL=https://download.pytorch.org/whl/cu128
STREAM_CHUNK_CHARS=360
STREAM_PREFETCH_CHUNKS=6

# Opcional: ativa quatro vozes neurais pt-BR do Azure Speech no nível Free F0.
# Nunca versione a chave real.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=brazilsouth
AZURE_SPEECH_ENDPOINT=https://brazilsouth.api.cognitive.microsoft.com/
AZURE_SPEECH_TIER=F0

# Opcional. As chaves também podem ser cadastradas criptografadas no Django Admin.
OPENAI_API_KEY=
AZURE_OPENAI_API_KEY=

# Túnel temporário. Obtenha o token em https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=
